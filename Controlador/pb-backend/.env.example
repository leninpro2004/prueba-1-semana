# ── Base de datos ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=puertas_blindadas
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_SCHEMA=inventario

# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_en_produccion
JWT_EXPIRES_IN=8h

# ── Recuperación de contraseña (B-02) ────────────────────
# false (por defecto): la recuperación la hace gerencia, y la de un gerente,
# el comando `npm run recuperar-acceso`. true SOLO en desarrollo: el token
# vuelve en la respuesta pública porque no hay envío de correo.
# Detalle: docs/fase-cierre/recuperacion-acceso.md
RECUPERACION_AUTOSERVICIO=false

# ── Firma de gerencia en acciones sensibles (F-11, D72) ─
# Todas activas por defecto. Para apagar alguna sin tocar código, listarla aquí
# separada por comas (catálogo en src/config/firmas.js). Ej.: movimiento_manual
# P-31: el cliente decide si la marcha blanca parte con movimiento_manual activo.
FIRMAS_DESACTIVADAS=

# ── Nube (sección 8.3 del plan): todas opcionales en local ─
# C-02: RDS exige SSL. true + la ruta del bundle de AWS (global-bundle.pem).
DB_SSL=false
# DB_SSL_CA=/etc/pb/global-bundle.pem
# C-04 y C-05: valores por defecto; cambiarlos solo si hace falta.
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_TIMEZONE=America/Santiago
# TZ=America/Santiago
# S-10: detrás de nginx, 1 para que el límite de intentos del login vea la IP real del usuario
# (y no 127.0.0.1 para todos). Vacío en local: sin proxy, el encabezado se podría falsificar.
TRUST_PROXY=
# En la nube: NODE_ENV=production, un JWT_SECRET largo y nuevo y RECUPERACION_AUTOSERVICIO=false.
# Guía completa: docs/fase-cierre/despliegue.md
