# Entorno de los tests automatizados.
# Solo se sobreescribe la base: el resto (host, usuario, contraseña, JWT_SECRET)
# se hereda de .env.
#
# El nombre DEBE terminar en "_test": los helpers abortan si no es así, porque
# los tests hacen TRUNCATE de todas las tablas.
DB_NAME=puertas_blindadas_test
NODE_ENV=test
